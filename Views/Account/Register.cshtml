@{
    ViewData["Title"] = "Đăng ký tài khoản hệ thống";
}

<!-- Google Fonts: Lora (Học thuật) & Be Vietnam Pro -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
<!-- Chỉ dùng Bootstrap Icons làm bộ font icon -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* 1. RESET & BIẾN MÀU CHỦ ĐẠO */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --color-bg-main: #F4F7F4;
        --color-teal-accent: #0A7E71;
        --color-teal-dark: #14352F;
        --color-mint-light: #E7F4EE;
        --color-mint-border: #C8E5D8;
        --color-amber: #F5A623;
        --color-amber-hover: #E29413;
        --color-text-title: #142E28;
        --color-text-body: #324B45;
        --color-text-muted: #748A84;
        --color-card-border: #E1EAE5;
        --color-danger-bg: #FDF2F2;
        --color-danger-text: #DC2626;
        --color-danger-border: #FCA5A5;
    }

    body {
        background-color: var(--color-bg-main);
        font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--color-text-body);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 32px 16px;
        -webkit-font-smoothing: antialiased;
        background-image: radial-gradient(circle at 10% 20%, rgba(10, 126, 113, 0.04) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(245, 166, 35, 0.05) 0%, transparent 40%);
    }

    .font-serif-academic {
        font-family: 'Lora', Georgia, serif;
    }

    /* 2. KHUNG CHỨA (WRAPPER) */
    .auth-container {
        width: 100%;
        max-width: 440px;
        margin: 0 auto;
    }

    /* 3. THẺ ĐĂNG KÝ (ACADEMIC CARD) */
    .academic-card {
        background: #ffffff;
        border: 1px solid var(--color-card-border);
        border-radius: 22px;
        padding: 40px 32px;
        box-shadow: 0 16px 36px rgba(20, 53, 47, 0.07), 0 2px 6px rgba(20, 53, 47, 0.03);
        transition: transform 0.2s ease;
    }

    /* 4. BIỂU TƯỢNG LOGO PHÍA TRÊN */
    .login-icon-box {
        width: 72px;
        height: 72px;
        background: linear-gradient(135deg, var(--color-mint-light) 0%, #d8eee3 100%);
        border: 2px solid var(--color-mint-border);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        color: var(--color-teal-accent);
        font-size: 30px;
        box-shadow: 0 6px 16px rgba(10, 126, 113, 0.12);
    }

    /* 5. TIÊU ĐỀ & MÔ TẢ */
    .auth-title {
        text-align: center;
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        margin-bottom: 6px;
    }

    .auth-subtitle {
        text-align: center;
        color: var(--color-text-muted);
        font-size: 14px;
        margin-bottom: 28px;
    }

    /* 6. FORM & INPUTS */
    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 13.5px;
        color: var(--color-teal-dark);
        margin-bottom: 8px;
    }

        .form-label i {
            color: var(--color-teal-accent);
            font-size: 15px;
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-field {
        width: 100%;
        border: 1.5px solid var(--color-card-border);
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 14.5px;
        font-family: inherit;
        color: var(--color-text-title);
        background-color: #FAFCFA;
        outline: none;
        transition: all 0.2s ease;
    }

        .input-field::placeholder {
            color: #9DB0AA;
        }

        .input-field:focus {
            border-color: var(--color-teal-accent);
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(10, 126, 113, 0.12);
        }

    /* 7. HỘP HIỂN THỊ LỖI (VALIDATION) */
    .validation-alert {
        background-color: var(--color-danger-bg);
        border: 1px solid var(--color-danger-border);
        color: var(--color-danger-text);
        font-size: 13px;
        font-weight: 500;
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 20px;
        line-height: 1.5;
    }

        .validation-alert ul {
            list-style-type: none;
            padding-left: 0;
            margin: 0;
        }

    /* 8. NÚT ĐĂNG KÝ */
    .btn-submit-amber {
        width: 100%;
        background-color: var(--color-amber);
        color: #173831;
        border: none;
        border-radius: 12px;
        padding: 13px 20px;
        font-size: 15px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 6px 16px rgba(245, 166, 35, 0.25);
        margin-top: 10px;
        margin-bottom: 24px;
    }

        .btn-submit-amber:hover {
            background-color: var(--color-amber-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(245, 166, 35, 0.35);
        }

        .btn-submit-amber:active {
            transform: translateY(0);
        }

        .btn-submit-amber i {
            font-size: 18px;
            transition: transform 0.2s ease;
        }

        .btn-submit-amber:hover i {
            transform: translateX(4px);
        }

    /* 9. KHỐI CHUYỂN HƯỚNG ĐĂNG NHẬP */
    .register-footer-box {
        background-color: var(--color-bg-main);
        border-radius: 12px;
        padding: 14px;
        text-align: center;
        font-size: 13.5px;
        color: var(--color-text-muted);
    }

    .link-academic {
        color: var(--color-teal-accent);
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
        transition: color 0.15s ease;
    }

        .link-academic:hover {
            color: var(--color-teal-dark);
            text-decoration: underline;
        }

    /* 10. COPYRIGHT CUỐI TRANG */
    .auth-copyright {
        text-align: center;
        margin-top: 24px;
        font-size: 12.5px;
        color: var(--color-text-muted);
    }

    /* 11. RESPONSIVE DI ĐỘNG */
    @@media (max-width: 480px) {
        .academic-card {
            padding: 28px 20px;
            border-radius: 18px;
        }

        .auth-title {
            font-size: 1.45rem;
        }
    }
</style>

<div class="auth-container">
    <div class="academic-card">

        <!-- Biểu tượng học thuật -->
        <div class="login-icon-box">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <!-- Tiêu đề -->
        <h2 class="auth-title font-serif-academic">
            Đăng ký tài khoản
        </h2>
        <p class="auth-subtitle">
            Khởi tạo không gian Smart RAG của riêng bạn
        </p>

        <!-- Form Đăng ký -->
        <form asp-action="Register" method="post">

            <!-- Khu vực báo lỗi ModelState -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-alert" asp-validation-summary="All"></div>
            }

            <!-- Tên đăng nhập -->
            <div class="form-group">
                <label class="form-label" for="username">
                    <i class="bi bi-person-fill"></i> Tên tài khoản
                </label>
                <div class="input-wrapper">
                    <input type="text"
                           id="username"
                           name="username"
                           class="input-field"
                           placeholder="Nhập tên tài khoản..."
                           required
                           autocomplete="off" />
                </div>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label class="form-label" for="email">
                    <i class="bi bi-envelope-fill"></i> Địa chỉ Email
                </label>
                <div class="input-wrapper">
                    <input type="email"
                           id="email"
                           name="email"
                           class="input-field"
                           placeholder="example@domain.com"
                           required
                           autocomplete="off" />
                </div>
            </div>

            <!-- Mật khẩu -->
            <div class="form-group">
                <label class="form-label" for="password">
                    <i class="bi bi-shield-lock-fill"></i> Mật khẩu
                </label>
                <div class="input-wrapper">
                    <input type="password"
                           id="password"
                           name="password"
                           class="input-field"
                           placeholder="Nhập mật khẩu..."
                           required
                           autocomplete="new-password" />
                </div>
            </div>

            <!-- Nút gửi form -->
            <button type="submit" class="btn-submit-amber">
                <span>Đăng ký ngay</span>
                <i class="bi bi-arrow-right-short"></i>
            </button>

            <!-- Khối chuyển hướng đăng nhập -->
            <div class="register-footer-box">
                <span>Đã có tài khoản?</span>
                <a href="/Account/Login" class="link-academic">Đăng nhập ngay</a>
            </div>

        </form>
    </div>

    <!-- Bản quyền chân trang -->
    <div class="auth-copyright">
        &copy; @DateTime.Now.Year · Smart Document RAG System
    </div>
</div>