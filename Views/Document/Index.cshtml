@model List<SmartDocumentRAG.API.Models.Document>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Trang chủ Thư Viện Mở";
    var searchString = ViewData["SearchString"] as string ?? "";
    var totalDocs = Model?.Count ?? 0;
}

<style>
    /* 1. KHUNG CHỨA TOÀN TRANG CHỦ */
    .home-page-container {
        padding: 24px 32px 64px 32px;
        max-width: 1560px;
        margin: 0 auto;
    }

    @@media (max-width: 768px) {
        .home-page-container {
            padding: 16px 16px 48px 16px;
        }
    }

    /* 2. HERO BANNER BẰNG CSS GRID 2 CỘT */
    .hero-section {
        background: linear-gradient(135deg, #13463a 0%, #0d2e26 100%);
        border-radius: 24px;
        color: #ffffff;
        padding: 44px 40px;
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 36px;
        align-items: center;
        box-shadow: 0 12px 32px rgba(13, 46, 38, 0.2);
        position: relative;
    }

    @@media (max-width: 960px) {
        .hero-section {
            grid-template-columns: 1fr;
            padding: 32px 24px;
        }
        .hero-img-col {
            display: none; /* Ẩn ảnh trên màn hình nhỏ để ưu tiên tìm kiếm */
        }
    }

    .hero-badge {
        background-color: rgba(231, 244, 238, 0.15);
        color: #92E4CD;
        border: 1px solid rgba(146, 228, 205, 0.3);
        font-size: 11px;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 100px;
        letter-spacing: 0.8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 14px;
    }

    .hero-title {
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1.3;
        color: #ffffff;
        margin-bottom: 12px;
    }

    .hero-title span {
        color: #F8CB7C;
        font-style: italic;
    }

    .hero-subtitle {
        font-size: 15px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
        max-width: 520px;
        margin-bottom: 24px;
    }

    /* 3. THANH TÌM KIẾM & LIVE SEARCH DROPDOWN */
    .search-wrapper {
        position: relative;
        width: 100%;
        max-width: 560px;
    }

    .search-box-wrapper {
        width: 100%;
        background: #ffffff;
        border-radius: 14px;
        padding: 6px 8px 6px 16px;
        display: flex;
        align-items: center;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .search-box-wrapper:focus-within {
        transform: translateY(-1px);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3), 0 0 0 3px rgba(245, 166, 35, 0.35);
    }

    .search-input-field {
        border: none;
        outline: none;
        font-family: inherit;
        font-size: 14.5px;
        color: var(--color-text-title);
        background: transparent;
        flex-grow: 1;
        padding: 8px 6px;
    }

    .search-input-field::placeholder {
        color: #9DB0AA;
    }

    .btn-search-amber {
        background-color: var(--color-amber);
        color: #173831;
        border: none;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 700;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .btn-search-amber:hover {
        background-color: var(--color-amber-hover);
        transform: translateY(-1px);
    }

    /* Hộp gợi ý xổ xuống (Live Search) */
    .suggestions-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 12px 32px rgba(13, 46, 38, 0.25);
        z-index: 1050;
        overflow: hidden;
        display: none;
        border: 1.5px solid var(--color-card-border);
    }

    .suggestion-item {
        padding: 12px 18px;
        color: var(--color-text-title);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        border-bottom: 1px solid #F0F4F2;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .suggestion-item:hover {
        background-color: var(--color-mint-light);
        color: var(--color-teal-accent);
    }

    .suggestion-item:last-child {
        border-bottom: none;
    }

    /* Ảnh minh họa bên phải Hero */
    .hero-img-col {
        text-align: center;
    }

    .hero-img {
        width: 100%;
        max-width: 320px;
        height: 250px;
        object-fit: cover;
        border-radius: 20px;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
        border: 2px solid rgba(255, 255, 255, 0.15);
    }

    /* 4. THANH TIÊU ĐỀ SECTION */
    .section-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin: 44px 0 24px 0;
    }

    .section-subtitle-tag {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--color-teal-accent);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        margin-bottom: 4px;
    }

    .section-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        margin: 0;
    }

    .badge-count-pill {
        background: #ffffff;
        border: 1.5px solid var(--color-card-border);
        padding: 6px 16px;
        border-radius: 100px;
        font-size: 13px;
        color: var(--color-text-body);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .badge-count-pill strong {
        color: var(--color-teal-accent);
    }

    /* 5. LƯỚI TÀI LIỆU 4 CỘT HÀNG NGANG (CSS GRID) */
    .documents-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr)); /* ÉP BUỘC 4 CỘT */
        gap: 20px;
        width: 100%;
    }

    @@media (max-width: 1200px) {
        .documents-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 820px) {
        .documents-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 520px) {
        .documents-grid {
            grid-template-columns: 1fr;
        }
    }

    /* 6. THẺ TÀI LIỆU (DOC CARD) */
    .doc-card {
        background: #ffffff;
        border: 1.5px solid var(--color-card-border);
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 4px 14px rgba(18, 64, 53, 0.04);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        height: 100%;
    }

    .doc-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(18, 64, 53, 0.09);
        border-color: #B2D8C7;
    }

    .doc-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .badge-cat {
        background-color: var(--color-mint-light);
        color: var(--color-teal-accent);
        border: 1px solid var(--color-mint-border);
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .doc-icon-box {
        width: 32px;
        height: 32px;
        background: #F0F6F3;
        color: var(--color-teal-accent);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .doc-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.45;
        color: var(--color-text-title);
        margin: 0 0 12px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 44px;
        transition: color 0.15s ease;
    }

    .doc-card:hover .doc-title {
        color: var(--color-teal-accent);
    }

    .doc-meta {
        background-color: #F8FAF9;
        border-radius: 10px;
        padding: 8px 12px;
        font-size: 12px;
        margin-bottom: 16px;
    }

    .doc-meta-item {
        display: flex;
        justify-content: space-between;
        color: var(--color-text-muted);
        margin-bottom: 4px;
    }

    .doc-meta-item:last-child {
        margin-bottom: 0;
    }

    .doc-meta-item strong {
        color: var(--color-text-body);
    }

    .btn-view-doc {
        background-color: var(--color-mint-light);
        color: var(--color-teal-accent);
        font-size: 13.5px;
        font-weight: 600;
        height: 38px;
        border-radius: 10px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s ease;
        border: none;
        width: 100%;
    }

    .btn-view-doc:hover {
        background-color: var(--color-teal-accent);
        color: #ffffff;
    }

    .btn-view-doc i {
        transition: transform 0.2s ease;
    }

    .btn-view-doc:hover i {
        transform: translateX(3px);
    }

    .btn-processing-box {
        background: #F3F4F6;
        color: #9CA3AF;
        border: 1px solid #E5E7EB;
        border-radius: 10px;
        padding: 9px;
        text-align: center;
        font-size: 12.5px;
        width: 100%;
    }

    /* 7. TRẠNG THÁI RỖNG */
    .empty-result-box {
        background: #ffffff;
        border: 1.5px solid var(--color-card-border);
        border-radius: 20px;
        padding: 56px 24px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    .empty-result-box i {
        font-size: 3rem;
        color: #C8E5D8;
        margin-bottom: 12px;
        display: inline-block;
    }

    .empty-reset-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-teal-accent);
        border: 1.5px solid var(--color-card-border);
        border-radius: 100px;
        padding: 8px 20px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        margin-top: 14px;
        transition: all 0.2s ease;
    }

    .empty-reset-link:hover {
        background-color: var(--color-mint-light);
        color: var(--color-teal-dark);
        border-color: var(--color-mint-border);
    }
</style>

<div class="home-page-container">

    <!-- 1. HERO SECTION KÈM LIVE SEARCH -->
    <section class="hero-section">
        <div>
            <span class="hero-badge">
                <i class="bi bi-patch-check-fill"></i> THƯ VIỆN MỞ TRI THỨC
            </span>
            <h1 class="hero-title font-serif-academic">
                Tìm đúng tài liệu.<br />
                <span>Mở thêm góc nhìn mới.</span>
            </h1>
            <p class="hero-subtitle">
                Khám phá kho tàng tài liệu chất lượng cao từ cộng đồng và bắt đầu hành trình học hỏi của riêng bạn.
            </p>

            <!-- FORM TÌM KIẾM TÍCH HỢP LIVE SEARCH -->
            <form asp-action="Index" method="get" autocomplete="off">
                <div class="search-wrapper">
                    <div class="search-box-wrapper">
                        <i class="bi bi-search text-muted me-2"></i>
                        <input type="text" 
                               id="searchInput" 
                               name="searchString" 
                               value="@searchString"
                               class="search-input-field"
                               placeholder="Tìm theo tên file, người chia sẻ..." />
                        <button class="btn-search-amber" type="submit">Tìm kiếm</button>
                    </div>

                    <!-- KHUNG DROPDOWN GỢI Ý TỪ API -->
                    <div id="suggestionsBox" class="suggestions-dropdown"></div>
                </div>
            </form>
        </div>

        <!-- CỘT ẢNH MINH HỌA -->
        <div class="hero-img-col">
            <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=800&auto=format&fit=crop"
                 alt="Thư viện"
                 class="hero-img" />
        </div>
    </section>

    <!-- 2. TIÊU ĐỀ DANH SÁCH & SỐ LƯỢNG -->
    <div class="section-header-bar">
        <div>
            <div class="section-subtitle-tag">Khám phá</div>
            <h2 class="section-title font-serif-academic">
                @if (!string.IsNullOrEmpty(searchString))
                {
                    <span>Kết quả tìm kiếm cho: "@searchString"</span>
                }
                else
                {
                    <span>Tài liệu nổi bật</span>
                }
            </h2>
        </div>
        <div class="badge-count-pill">
            Tổng số: <strong>@totalDocs</strong> tài liệu
        </div>
    </div>

    <!-- 3. KHU VỰC HIỂN THỊ 4 CỘT HÀNG NGANG -->
    <section class="mb-5">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-result-box">
                <i class="bi bi-search"></i>
                <h3 class="font-serif-academic" style="font-size: 1.25rem; color: var(--color-teal-dark); margin-bottom: 6px;">
                    Không tìm thấy tài liệu phù hợp
                </h3>
                <p style="font-size: 14px; color: var(--color-text-muted); margin: 0;">
                    Không có tài liệu nào khớp với từ khóa tìm kiếm của bạn.
                </p>
                <a href="/Document" class="empty-reset-link">
                    <i class="bi bi-arrow-counterclockwise"></i> Quay lại tất cả tài liệu
                </a>
            </div>
        }
        else
        {
            string[] categories = { "Học thuật", "Công nghệ", "Nghiên cứu", "Kinh tế", "Sáng tạo" };
            int index = 0;

            <!-- LƯỚI 4 CỘT CSS GRID -->
            <div class="documents-grid">
                @foreach (var doc in Model)
                {
                    var isCompleted = doc.Status == "Completed";
                    var uploaderName = doc.User?.Username ?? "Cộng đồng";
                    var catTag = categories[index % categories.Length];
                    var fileExtension = System.IO.Path.GetExtension(doc.FileName)?.TrimStart('.').ToUpper();
                    if (string.IsNullOrEmpty(fileExtension)) { fileExtension = "DOC"; }
                    index++;

                    <div class="doc-card">
                        <div>
                            <!-- Header của thẻ -->
                            <div class="doc-card-top">
                                <span class="badge-cat">@catTag</span>
                                <div class="doc-icon-box">
                                    @if (fileExtension == "PDF")
                                    {
                                        <i class="bi bi-file-earmark-pdf-fill" style="color: #DC2626;"></i>
                                    }
                                    else if (fileExtension == "DOC" || fileExtension == "DOCX")
                                    {
                                        <i class="bi bi-file-earmark-word-fill" style="color: #2563EB;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-text-fill"></i>
                                    }
                                </div>
                            </div>

                            <!-- Tiêu đề tệp -->
                            <h3 class="doc-title" title="@doc.FileName">
                                @doc.FileName
                            </h3>

                            <!-- Thông tin phụ -->
                            <div class="doc-meta">
                                <div class="doc-meta-item">
                                    <span><i class="bi bi-calendar3 me-1"></i> Ngày tải:</span>
                                    <strong>@doc.UploadedAt.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="doc-meta-item">
                                    <span><i class="bi bi-person me-1"></i> Người tải:</span>
                                    <strong class="text-truncate ms-2" style="max-width: 110px;" title="@uploaderName">@uploaderName</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Nút chi tiết -->
                        <div>
                            @if (isCompleted)
                            {
                                <a href="/Document/Details/@doc.Id" class="btn-view-doc">
                                    <span>Xem chi tiết</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                            else
                            {
                                <div class="btn-processing-box">
                                    <i class="bi bi-hourglass-split me-1"></i> Đang xử lý...
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const suggestionsBox = document.getElementById('suggestionsBox');

        // Lắng nghe sự kiện gõ phím vào ô tìm kiếm (Live Autocomplete)
        searchInput.addEventListener('input', async function() {
            const query = this.value.trim();

            if (query.length < 2) {
                suggestionsBox.style.display = 'none';
                suggestionsBox.innerHTML = '';
                return;
            }

            try {
                const response = await fetch(`/api/Document/suggestions?query=${encodeURIComponent(query)}`);
                if (!response.ok) return;

                const items = await response.json();

                if (!items || items.length === 0) {
                    suggestionsBox.style.display = 'none';
                    return;
                }

                let html = '';
                items.forEach(item => {
                    html += `<a href="/Document/Details/${item.id}" class="suggestion-item">
                                <i class="bi bi-file-earmark-pdf-fill" style="color: #DC2626;"></i> 
                                <span>${escapeHtml(item.fileName)}</span>
                             </a>`;
                });

                suggestionsBox.innerHTML = html;
                suggestionsBox.style.display = 'block';

            } catch (err) {
                console.error("Lỗi khi tải gợi ý tìm kiếm:", err);
            }
        });

        // Ẩn khung gợi ý khi click ra ngoài
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                suggestionsBox.style.display = 'none';
            }
        });

        function escapeHtml(text) {
            if (!text) return '';
            return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
}