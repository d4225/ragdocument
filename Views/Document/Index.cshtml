@{
    ViewData["Title"] = "Smart Document RAG";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f5f7fb;
                font-family: "Segoe UI", sans-serif;
            }

            .card {
                border: none;
                border-radius: 15px;
                box-shadow: 0 5px 20px rgba(0,0,0,.08);
            }

            .upload-box {
                border: 2px dashed #0d6efd;
                border-radius: 12px;
                padding: 30px;
                text-align: center;
                background: #fff;
            }

                .upload-box:hover {
                    background: #f8fbff;
                }

            #result {
                display: none;
            }
    </style>
</head>

<body>

    <div class="container py-5">

        <h2 class="text-primary fw-bold mb-4">
            📄 Smart Document RAG
        </h2>

        <div class="card p-4">

            <h4 class="mb-3">Upload tài liệu PDF</h4>

            <p class="text-muted">
                Chọn một file PDF để tải lên. Sau khi upload thành công,
                Hangfire sẽ xử lý file ở chế độ nền.
            </p>

            <form id="uploadForm">

                <div class="upload-box mb-3">
                    <input type="file"
                           id="fileInput"
                           accept=".pdf"
                           class="form-control form-control-lg"
                           required />
                </div>

                <button id="btnUpload"
                        type="submit"
                        class="btn btn-primary btn-lg w-100">

                    <span id="btnText">Tải lên & Xử lý</span>

                    <span id="spinner"
                          class="spinner-border spinner-border-sm ms-2 d-none">
                    </span>

                </button>

            </form>

            <div id="result" class="alert mt-4"></div>

        </div>

    </div>

    <script>

                    // Route đúng với DocumentController
                    const API_URL = "/api/Document/upload";

                    document
                        .getElementById("uploadForm")
                        .addEventListener("submit", uploadFile);

                    async function uploadFile(e) {

                        e.preventDefault();

                        const file = document.getElementById("fileInput").files[0];

                        if (!file) {
                            showMessage("Vui lòng chọn file PDF!", "danger");
                            return;
                        }

                        const formData = new FormData();

                        formData.append("file", file);

                        // Guid giả để test
                        formData.append(
                            "userId",
                            "11111111-1111-1111-1111-111111111111"
                        );

                        setLoading(true);

                        try {

                            const response = await fetch(API_URL, {
                                method: "POST",
                                body: formData
                            });

                            if (response.ok) {

                                const data = await response.json();

                                showMessage(
                                    `Upload thành công!
            Document ID: ${data.documentId}
            Trạng thái: ${data.status}`,
                                    "success"
                                );

                                document.getElementById("fileInput").value = "";

                            } else {

                                const error = await response.text();

                                showMessage("Lỗi: " + error, "danger");

                            }

                        }
                        catch {

                            showMessage(
                                "Không thể kết nối đến Web API.",
                                "danger"
                            );

                        }
                        finally {

                            setLoading(false);

                        }

                    }

                    function setLoading(state) {

                        const btn = document.getElementById("btnUpload");
                        const text = document.getElementById("btnText");
                        const spinner = document.getElementById("spinner");

                        btn.disabled = state;

                        if (state) {
                            text.innerText = "Đang upload...";
                            spinner.classList.remove("d-none");
                        }
                        else {
                            text.innerText = "Tải lên & Xử lý";
                            spinner.classList.add("d-none");
                        }

                    }

                    function showMessage(message, type) {

                        const box = document.getElementById("result");

                        box.style.display = "block";
                        box.className = `alert alert-${type} mt-4`;
                        box.innerText = message;

                    }

    </script>
    <!-- Block 3: Kiểm thử Hybrid Search & Parent Retrieval -->
    <div class="card p-4 mt-4">
        <h5 class="card-title fw-bold text-secondary mb-3">3. Thử nghiệm Hybrid Search & Parent Retrieval</h5>
        <div class="input-group mb-3">
            <input type="text" id="txtSearch" class="form-control form-control-lg" placeholder="Nhập câu hỏi hoặc từ khóa cần tìm trong tài liệu...">
            <button class="btn btn-success btn-lg" type="button" onclick="executeSearch()">Tìm kiếm</button>
        </div>

        <div id="searchResults" class="mt-3"></div>
    </div>

    <script>
                        async function executeSearch() {
                const query = document.getElementById('txtSearch').value.trim();
                const resultsDiv = document.getElementById('searchResults');

                if (!query) {
                    resultsDiv.innerHTML =
                        '<div class="alert alert-warning">Vui lòng nhập từ khóa tìm kiếm.</div>';
                    return;
                }

                resultsDiv.innerHTML =
                    '<div class="text-center text-muted">Đang tìm kiếm...</div>';

                try {
                    const url =
                        `/api/Document/search?query=${encodeURIComponent(query)}&topK=5`;

                    console.log("Search API:", url);

                    const response = await fetch(url);

                    console.log("Search status:", response.status);

                    // Đọc response trước để biết server thực sự trả gì
                    const responseText = await response.text();

                    console.log("Search response:", responseText);

                    if (!response.ok) {
                        resultsDiv.innerHTML = `
                            <div class="alert alert-danger">
                                <strong>Lỗi Search API</strong><br>
                                HTTP Status: ${response.status}<br>
                                ${responseText}
                            </div>
                        `;
                        return;
                    }

                    const data = JSON.parse(responseText);

                    if (!data || data.length === 0) {
                        resultsDiv.innerHTML =
                            '<div class="alert alert-warning">Không tìm thấy đoạn văn bản phù hợp.</div>';
                        return;
                    }

                    let html =
                        '<h6 class="fw-bold mb-3">Kết quả Parent Chunks khớp nhất:</h6>';

                    data.forEach((item, index) => {

                        const score =
                            typeof item.score === "number"
                                ? item.score.toFixed(4)
                                : "N/A";

                        html += `
                            <div class="card mb-3 border-start border-primary border-4 shadow-sm">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>
                                            <strong>Thứ hạng #${index + 1}</strong>
                                            (RRF Score: ${score})
                                        </span>

                                        <span>
                                            Trang PDF:
                                            <strong>${item.pageNumber ?? "N/A"}</strong>
                                        </span>
                                    </div>

                                    <p class="card-text text-dark">
                                        <strong>Nội dung Parent Chunk:</strong>
                                    </p>

                                    <blockquote class="blockquote bg-light p-3 rounded fs-6">
                                        ${item.parentContent ?? ""}
                                    </blockquote>

                                    <details class="text-muted small">
                                        <summary>
                                            Xem Child Chunk kích hoạt (Match)
                                        </summary>

                                        <p class="mt-2 text-secondary">
                                            ${item.childContent ?? ""}
                                        </p>
                                    </details>

                                </div>
                            </div>
                        `;
                    });

                    resultsDiv.innerHTML = html;

                } catch (error) {

                    console.error("Search error:", error);

                    resultsDiv.innerHTML = `
                        <div class="alert alert-danger">
                            <strong>Không thể kết nối API Search.</strong><br>
                            ${error.message}
                        </div>
                    `;
                }
            }
    </script>
    <!-- Block 3: Khung Hỏi Đáp RAG với Gemini -->
    <div class="card p-4 mt-4 shadow-sm">
        <h5 class="card-title fw-bold text-primary mb-3">
            💬 Hỏi đáp Tài liệu với Gemini AI (RAG)
        </h5>

        <div class="mb-3">
            <label for="txtQuestion" class="form-label font-weight-bold">Đặt câu hỏi về nội dung tài liệu đã tải lên:</label>
            <textarea id="txtQuestion" class="form-control" rows="3" placeholder="Ví dụ: Quy trình đăng ký phòng ký túc xá gồm những bước nào?"></textarea>
        </div>

        <button class="btn btn-primary btn-lg w-100 mb-4" id="btnAsk" onclick="sendRagQuestion()">
            Gửi câu hỏi
        </button>

        <!-- Khung hiển thị câu trả lời AI -->
        <div id="aiResponseContainer" style="display: none;">
            <div class="card bg-light mb-3 border-start border-success border-4">
                <div class="card-body">
                    <h6 class="fw-bold text-success mb-2">🤖 Câu trả lời từ Gemini AI:</h6>
                    <div id="aiAnswer" class="lh-base" style="white-space: pre-line;"></div>
                </div>
            </div>

            <!-- Khung hiển thị Nguồn trích dẫn (Citations) -->
            <div class="card border-info">
                <div class="card-header bg-info text-white fw-bold">
                    📌 Nguồn thông tin trích dẫn (Citations)
                </div>
                <ul id="citationList" class="list-group list-group-flush"></ul>
            </div>
        </div>
    </div>

    <script>
            async function sendRagQuestion() {
                const question = document.getElementById('txtQuestion').value.trim();
                const btnAsk = document.getElementById('btnAsk');
                const container = document.getElementById('aiResponseContainer');
                const aiAnswerDiv = document.getElementById('aiAnswer');
                const citationList = document.getElementById('citationList');

                if (!question) {
                    alert('Vui lòng nhập câu hỏi!');
                    return;
                }

                btnAsk.disabled = true;
                btnAsk.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang truy xuất dữ liệu & Gemini đang suy nghĩ...';
                container.style.display = 'none';

                try {
                    const response = await fetch('/api/Document/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ question: question, topK: 5 })
                    });

                    if (!response.ok) {
                        alert('Lỗi khi gửi câu hỏi tới AI!');
                        return;
                    }

                    const data = await response.json();

                    // Hiển thị kết quả
                    aiAnswerDiv.innerText = data.answer;
                    citationList.innerHTML = '';

                    if (data.citations && data.citations.length > 0) {
                        data.citations.forEach(item => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item';
                            li.innerHTML = `
                                <div class="d-flex justify-content-between">
                                    <strong>📄 ${item.documentName}</strong>
                                    <span class="badge bg-secondary">Trang ${item.pageNumber}</span>
                                </div>
                                <p class="text-muted small mt-1 mb-0"><em>"${item.snippet}"</em></p>
                            `;
                            citationList.appendChild(li);
                        });
                    } else {
                        citationList.innerHTML = '<li class="list-group-item text-muted">Không có trích dẫn nguồn.</li>';
                    }

                    container.style.display = 'block';
                } catch (err) {
                    alert('Lỗi kết nối Server!');
                } finally {
                    btnAsk.disabled = false;
                    btnAsk.innerText = 'Gửi câu hỏi';
                }
            }
    </script>

</body>
</html>