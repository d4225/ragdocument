@{
    ViewData["Title"] = "Smart Document RAG";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
            body {
                background: #f5f7fb;
                font-family: "Segoe UI", sans-serif;
            }

            .card {
                border: none;
                border-radius: 15px;
                box-shadow: 0 5px 20px rgba(0,0,0,.08);
            }

            .upload-box {
                border: 2px dashed #0d6efd;
                border-radius: 12px;
                padding: 30px;
                text-align: center;
                background: #fff;
            }

            .upload-box:hover {
                background: #f8fbff;
            }

            #result {
                display: none;
            }

            /* Style bổ sung cho Khung Chat Multi-turn */
            .chat-box {
                height: 400px;
                overflow-y: auto;
                background-color: #f8f9fa;
                border-radius: 10px;
                padding: 15px;
            }

            .chat-bubble {
                max-width: 80%;
                padding: 10px 14px;
                border-radius: 12px;
                margin-bottom: 10px;
                line-height: 1.5;
            }

            .user-bubble {
                background-color: #0d6efd;
                color: white;
                margin-left: auto;
                border-bottom-right-radius: 2px;
            }

            .assistant-bubble {
                background-color: #ffffff;
                color: #212529;
                margin-right: auto;
                border-bottom-left-radius: 2px;
                border: 1px solid #dee2e6;
            }

            .citation-box {
                font-size: 0.8rem;
                background-color: #eef2f7;
                border-left: 3px solid #0d6efd;
                padding: 5px 8px;
                margin-top: 6px;
                border-radius: 0 4px 4px 0;
            }
    </style>
</head>

<body>

    <div class="container py-5">

        <h2 class="text-primary fw-bold mb-4">
            📄 Smart Document RAG Workspace
        </h2>

        <!-- BLOCK 1: UPLOAD TÀI LIỆU -->
        <div class="card p-4 mb-4">
            <h4 class="mb-3">1. Upload tài liệu PDF</h4>
            <p class="text-muted">
                Chọn một file PDF để tải lên. Sau khi upload thành công, Hangfire sẽ xử lý file ở chế độ nền.
            </p>

            <form id="uploadForm">
                <div class="upload-box mb-3">
                    <input type="file" id="fileInput" accept=".pdf" class="form-control form-control-lg" required />
                </div>
                <button id="btnUpload" type="submit" class="btn btn-primary btn-lg w-100">
                    <span id="btnText">Tải lên & Xử lý</span>
                    <span id="spinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                </button>
            </form>
            <div id="result" class="alert mt-4"></div>
        </div>

        <!-- BLOCK 2: KIỂM THỬ HYBRID SEARCH -->
        <div class="card p-4 mb-4">
            <h5 class="card-title fw-bold text-secondary mb-3">2. Thử nghiệm Hybrid Search & Parent Retrieval</h5>
            <div class="input-group mb-3">
                <input type="text" id="txtSearch" class="form-control form-control-lg" placeholder="Nhập câu hỏi hoặc từ khóa cần tìm...">
                <button class="btn btn-success btn-lg" type="button" onclick="executeSearch()">Tìm kiếm</button>
            </div>
            <div id="searchResults" class="mt-3"></div>
        </div>

        <!-- BLOCK 3: KHUNG CHAT MULTI-TURN RAG (NÂNG CẤP TUẦN 6) -->
        <div class="card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title fw-bold text-primary m-0">
                    💬 Chat Multi-turn với Gemini AI (Lưu Context)
                </h5>
                <button class="btn btn-outline-secondary btn-sm" onclick="startNewChat()">
                    <i class="bi bi-plus-lg"></i> Cuộc trò chuyện mới
                </button>
            </div>

            <!-- Nơi chứa nội dung hội thoại -->
            <div id="chatContainer" class="chat-box mb-3">
                <div class="text-center text-muted my-5" id="chatEmptyState">
                    <i class="bi bi-chat-dots display-4"></i>
                    <p class="mt-2">Chưa có tin nhắn nào. Hãy bắt đầu bằng một câu hỏi!</p>
                </div>
            </div>

            <!-- Khung nhập tin nhắn -->
            <form id="chatForm" onsubmit="handleSendRagChat(event)">
                <div class="input-group">
                    <input type="text" id="txtChatQuestion" class="form-control form-control-lg" placeholder="Nhập câu hỏi nối tiếp..." autocomplete="off" required />
                    <button class="btn btn-primary px-4" type="submit" id="btnSendChat">
                        Gửi câu hỏi
                    </button>
                </div>
            </form>
        </div>

    </div>

    <!-- SCRIPT XỬ LÝ TOÀN BỘ LOGIC -->
    <script>
            // --- 1. SCRIPT UPLOAD FILE ---
            const UPLOAD_API = "/api/Document/upload";
            document.getElementById("uploadForm").addEventListener("submit", uploadFile);

            async function uploadFile(e) {
                e.preventDefault();
                const file = document.getElementById("fileInput").files[0];
                if (!file) {
                    showMessage("Vui lòng chọn file PDF!", "danger");
                    return;
                }

                const formData = new FormData();
                formData.append("file", file);
                formData.append("userId", "11111111-1111-1111-1111-111111111111");

                setLoading(true);
                try {
                    const response = await fetch(UPLOAD_API, { method: "POST", body: formData });
                    if (response.ok) {
                        const data = await response.json();
                        showMessage(`Upload thành công! Document ID: ${data.documentId}`, "success");
                        document.getElementById("fileInput").value = "";
                    } else {
                        const error = await response.text();
                        showMessage("Lỗi: " + error, "danger");
                    }
                } catch {
                    showMessage("Không thể kết nối đến Web API.", "danger");
                } finally {
                    setLoading(false);
                }
            }

            function setLoading(state) {
                const btn = document.getElementById("btnUpload");
                const text = document.getElementById("btnText");
                const spinner = document.getElementById("spinner");
                btn.disabled = state;
                text.innerText = state ? "Đang upload..." : "Tải lên & Xử lý";
                spinner.classList.toggle("d-none", !state);
            }

            function showMessage(message, type) {
                const box = document.getElementById("result");
                box.style.display = "block";
                box.className = `alert alert-${type} mt-4`;
                box.innerText = message;
            }

            // --- 2. SCRIPT HYBRID SEARCH ---
            async function executeSearch() {
                const query = document.getElementById('txtSearch').value.trim();
                const resultsDiv = document.getElementById('searchResults');
                if (!query) {
                    resultsDiv.innerHTML = '<div class="alert alert-warning">Vui lòng nhập từ khóa tìm kiếm.</div>';
                    return;
                }

                resultsDiv.innerHTML = '<div class="text-center text-muted">Đang tìm kiếm...</div>';
                try {
                    const response = await fetch(`/api/Document/search?query=${encodeURIComponent(query)}&topK=5`);
                    if (!response.ok) {
                        resultsDiv.innerHTML = `<div class="alert alert-danger">Lỗi Search API: ${response.status}</div>`;
                        return;
                    }
                    const data = await response.json();
                    if (!data || data.length === 0) {
                        resultsDiv.innerHTML = '<div class="alert alert-warning">Không tìm thấy kết quả.</div>';
                        return;
                    }

                    let html = '<h6 class="fw-bold mb-3">Kết quả Parent Chunks:</h6>';
                    data.forEach((item, index) => {
                        html += `
                            <div class="card mb-3 border-start border-primary border-4 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span><strong>#${index + 1}</strong> (Score: ${item.score ? item.score.toFixed(4) : 'N/A'})</span>
                                        <span>Trang: <strong>${item.pageNumber ?? "N/A"}</strong></span>
                                    </div>
                                    <blockquote class="blockquote bg-light p-3 rounded fs-6">${item.parentContent ?? ""}</blockquote>
                                </div>
                            </div>`;
                    });
                    resultsDiv.innerHTML = html;
                } catch (error) {
                    resultsDiv.innerHTML = `<div class="alert alert-danger">Lỗi kết nối: ${error.message}</div>`;
                }
            }

            // --- 3. SCRIPT MULTI-TURN CHAT (NÂNG CẤP TUẦN 6) ---
            let currentSessionId = null; // Lưu Session ID hiện tại

            function startNewChat() {
                currentSessionId = null;
                document.getElementById('chatContainer').innerHTML = `
                    <div class="text-center text-muted my-5" id="chatEmptyState">
                        <i class="bi bi-chat-dots display-4"></i>
                        <p class="mt-2">Đã mở cuộc trò chuyện mới. Hãy đặt câu hỏi!</p>
                    </div>`;
            }

                        async function handleSendRagChat(event) {
                event.preventDefault();
                const input = document.getElementById('txtChatQuestion');
                const btnSend = document.getElementById('btnSendChat');
                const question = input.value.trim();

                if (!question) return;

                const emptyState = document.getElementById('chatEmptyState');
                if (emptyState) emptyState.remove();

                appendMessage('user', question);
                input.value = '';
                input.disabled = true;
                btnSend.disabled = true;

                // Tạo một khung chứa câu trả lời AI trống để đổ dữ liệu dần vào
                const bubbleId = 'ai-bubble-' + Date.now();
                appendStreamingPlaceholder(bubbleId);
                scrollToBottom();

                try {
                    const response = await fetch('/api/Document/chat-stream', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ question: question, topK: 4 })
                    });

                    if (!response.ok) throw new Error("Lỗi kết nối Stream API");

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder();
                    let fullText = "";

                    while (true) {
                        const { value, done } = await reader.read();
                        if (done) break;

                        const chunk = decoder.decode(value, { stream: true });
                        const lines = chunk.split('\n');

                        for (const line of lines) {
                            if (line.startsWith('data: ')) {
                                try {
                                    const json = JSON.parse(line.substring(6));
                                    if (json.text) {
                                        fullText += json.text;
                                        document.getElementById(bubbleId).innerText = fullText;
                                        scrollToBottom();
                                    }
                                    if (json.done && json.citations) {
                                        appendCitationsToBubble(bubbleId, json.citations);
                                    }
                                    if (json.error) {
                                        document.getElementById(bubbleId).innerText = "⚠️ Lỗi: " + json.error;
                                    }
                                } catch (e) {}
                            }
                        }
                    }
                } catch (err) {
                    document.getElementById(bubbleId).innerText = "⚠️ Lỗi hệ thống: " + err.message;
                } finally {
                    input.disabled = false;
                    btnSend.disabled = false;
                    input.focus();
                    scrollToBottom();
                }
            }

            function appendStreamingPlaceholder(id) {
                const chatContainer = document.getElementById('chatContainer');
                const wrapper = document.createElement('div');
                wrapper.className = 'd-flex w-100';
                wrapper.innerHTML = `<div class="chat-bubble assistant-bubble" id="${id}">Đang kết nối với Gemini...</div>`;
                chatContainer.appendChild(wrapper);
            }

            function appendCitationsToBubble(bubbleId, citations) {
                const bubble = document.getElementById(bubbleId).parentElement;
                if (!citations || citations.length === 0) return;

                const citeHeader = document.createElement('div');
                citeHeader.className = 'fw-bold text-secondary mt-2 mb-1';
                citeHeader.style.fontSize = '0.75rem';
                citeHeader.innerText = 'Trích dẫn nguồn:';
                bubble.appendChild(citeHeader);

                citations.forEach(c => {
                    const citeBox = document.createElement('div');
                    citeBox.className = 'citation-box';
                    citeBox.innerHTML = `<strong>📄 ${escapeHtml(c.documentName)}</strong>: "${escapeHtml(c.snippet)}"`;
                    bubble.appendChild(citeBox);
                });
            }

            function appendMessage(sender, content, citations = []) {
                const chatContainer = document.getElementById('chatContainer');
                const isUser = sender === 'user';

                const wrapper = document.createElement('div');
                wrapper.className = `d-flex w-100`;

                const bubble = document.createElement('div');
                bubble.className = `chat-bubble ${isUser ? 'user-bubble' : 'assistant-bubble'}`;
                bubble.innerText = content;

                // Hiển thị Citations nếu là AI
                if (!isUser && citations && citations.length > 0) {
                    const citeHeader = document.createElement('div');
                    citeHeader.className = 'fw-bold text-secondary mt-2 mb-1';
                    citeHeader.style.fontSize = '0.75rem';
                    citeHeader.innerText = 'Trích dẫn nguồn:';
                    bubble.appendChild(citeHeader);

                    citations.forEach(c => {
                        const citeBox = document.createElement('div');
                        citeBox.className = 'citation-box';
                        citeBox.innerHTML = `<strong>📄 ${escapeHtml(c.documentName)}</strong>: "${escapeHtml(c.snippet)}"`;
                        bubble.appendChild(citeBox);
                    });
                }

                wrapper.appendChild(bubble);
                chatContainer.appendChild(wrapper);
            }

            function appendLoading() {
                const id = 'loading-' + Date.now();
                const chatContainer = document.getElementById('chatContainer');
                const wrapper = document.createElement('div');
                wrapper.id = id;
                wrapper.className = 'd-flex w-100';
                wrapper.innerHTML = `
                    <div class="chat-bubble assistant-bubble text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span>Gemini đang suy nghĩ...
                    </div>`;
                chatContainer.appendChild(wrapper);
                return id;
            }

            function removeLoading(id) {
                const elem = document.getElementById(id);
                if (elem) elem.remove();
            }

            function scrollToBottom() {
                const chatContainer = document.getElementById('chatContainer');
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            function escapeHtml(text) {
                if (!text) return '';
                return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            }
    </script>
</body>
</html>