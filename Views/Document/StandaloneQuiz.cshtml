@{
    Layout = "_Layout";
    ViewData["Title"] = "Trình tạo Trắc nghiệm Độc lập";
}

<style>
    /* 1. KHUNG CHỨA TOÀN TRANG (CĂN GIỮA ĐẸP MẮT) */
    .standalone-container {
        max-width: 860px;
        margin: 0 auto;
        padding: 20px 20px 56px 20px;
    }

    /* Nút quay lại đầu trang */
    .top-return-nav {
        margin-bottom: 16px;
    }

    .link-back-library {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-text-sub);
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .link-back-library:hover {
            color: var(--color-teal-accent);
            transform: translateX(-3px);
        }

    /* 2. THẺ CHÍNH (ACADEMIC CARD) */
    .academic-card {
        background: #ffffff;
        border: 1.5px solid var(--color-card-border);
        border-radius: 20px;
        padding: 32px 30px;
        box-shadow: 0 6px 20px rgba(20, 53, 47, 0.05);
    }

    /* HEADER QUIZ */
    .quiz-header {
        border-bottom: 1.5px solid var(--color-card-border);
        padding-bottom: 18px;
        margin-bottom: 24px;
    }

    .quiz-badge-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: var(--color-mint-light);
        color: var(--color-teal-accent);
        border: 1px solid var(--color-mint-border);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 100px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .quiz-main-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        margin: 0 0 6px 0;
    }

    .quiz-sub-desc {
        font-size: 13.5px;
        color: var(--color-text-sub);
        margin: 0;
        line-height: 1.5;
    }

    /* 3. VÙNG TẢI FILE PDF (DROPZONE) */
    .field-label {
        display: block;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--color-text-sub);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .upload-dropzone {
        border: 2px dashed var(--color-mint-border);
        border-radius: 16px;
        background-color: #FAFCFA;
        padding: 36px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.22s ease;
        margin-bottom: 24px;
    }

        .upload-dropzone:hover {
            border-color: var(--color-teal-accent);
            background-color: var(--color-mint-light);
        }

    .dropzone-icon {
        font-size: 3rem;
        color: var(--color-teal-accent);
        margin-bottom: 10px;
        display: inline-block;
        line-height: 1;
    }

    .dropzone-file-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--color-text-title);
        margin-bottom: 4px;
    }

    .dropzone-hint {
        font-size: 12px;
        color: var(--color-text-sub);
        margin: 0;
    }

    /* SELECT SỐ CÂU HỎI */
    .select-wrap {
        max-width: 320px;
        margin-bottom: 28px;
    }

    .academic-select {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--color-card-border);
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-text-title);
        background-color: #FAFCFA;
        font-family: inherit;
        outline: none;
        cursor: pointer;
        transition: border-color 0.2s ease;
    }

        .academic-select:focus {
            border-color: var(--color-teal-accent);
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(10, 126, 113, 0.12);
        }

    /* NÚT BẤM (BUTTONS) */
    .btn-amber-cta {
        background-color: var(--color-amber);
        color: #173831;
        border: none;
        border-radius: 12px;
        padding: 12px 32px;
        font-size: 14.5px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 3px 12px rgba(245, 166, 35, 0.25);
        transition: all 0.2s ease;
    }

        .btn-amber-cta:hover {
            background-color: var(--color-amber-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(245, 166, 35, 0.35);
        }

    .btn-teal-cta {
        background-color: var(--color-teal-accent);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 12px 36px;
        font-size: 14.5px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 3px 12px rgba(10, 126, 113, 0.22);
        transition: all 0.2s ease;
    }

        .btn-teal-cta:hover {
            background-color: #08665B;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(10, 126, 113, 0.3);
        }

    .btn-outline-neutral {
        background: #ffffff;
        color: var(--color-text-sub);
        border: 1.5px solid var(--color-card-border);
        border-radius: 100px;
        padding: 9px 24px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

        .btn-outline-neutral:hover {
            background-color: #F8FAF9;
            border-color: #CBD5E1;
            color: var(--color-text-title);
        }

    /* 4. MÀN HÌNH LOADING CHỜ AI */
    .loading-state-container {
        text-align: center;
        padding: 48px 16px;
    }

    .academic-spinner {
        display: inline-block;
        width: 44px;
        height: 44px;
        border: 3.5px solid rgba(10, 126, 113, 0.2);
        border-top-color: var(--color-teal-accent);
        border-radius: 50%;
        animation: spinAnim 0.75s linear infinite;
        margin-bottom: 16px;
    }

    @@keyframes spinAnim {
        to {
            transform: rotate(360deg);
        }
    }

    /* 5. CÂU HỎI QUIZ & OPTIONS */
    .question-card {
        background: #FAFCFA;
        border: 1.5px solid var(--color-card-border);
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 20px;
        transition: border-color 0.2s ease;
    }

    .question-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-text-title);
        line-height: 1.5;
        margin-bottom: 16px;
    }

    .question-index-badge {
        color: var(--color-teal-accent);
        margin-right: 4px;
    }

    .options-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .option-label {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border: 1.5px solid var(--color-card-border);
        border-radius: 12px;
        background: #ffffff;
        cursor: pointer;
        font-size: 14px;
        color: var(--color-text-title);
        transition: all 0.18s ease;
    }

        .option-label:hover {
            border-color: var(--color-teal-accent);
            background-color: var(--color-mint-light);
        }

        .option-label input[type="radio"] {
            accent-color: var(--color-teal-accent);
            width: 17px;
            height: 17px;
            cursor: pointer;
        }

    .option-key {
        font-weight: 700;
        color: var(--color-text-sub);
        min-width: 20px;
    }

    /* Style đáp án khi nộp bài */
    .option-label.opt-correct {
        background-color: var(--color-mint-light) !important;
        border-color: var(--color-teal-accent) !important;
        color: var(--color-teal-dark) !important;
        font-weight: 600;
    }

    .option-label.opt-wrong {
        background-color: #FDF2F2 !important;
        border-color: #FCA5A5 !important;
        color: #DC2626 !important;
    }

    /* Hộp giải thích của AI */
    .explanation-box {
        display: none;
        margin-top: 14px;
        padding: 12px 16px;
        border-radius: 10px;
        background-color: #ffffff;
        border: 1.5px solid var(--color-card-border);
        border-left: 4px solid var(--color-teal-accent);
        font-size: 13px;
        line-height: 1.55;
        color: var(--color-text-sub);
    }

        .explanation-box strong {
            color: var(--color-teal-dark);
        }

    /* 6. BANNER KẾT QUẢ ĐIỂM SỐ */
    .result-banner-box {
        display: none;
        text-align: center;
        background: linear-gradient(135deg, #13463a 0%, #0d2e26 100%);
        color: #ffffff;
        border-radius: 18px;
        padding: 28px 20px;
        margin-bottom: 26px;
        box-shadow: 0 6px 24px rgba(18, 64, 53, 0.15);
    }

    .result-score-num {
        font-size: 2.5rem;
        font-weight: 700;
        color: #F8CB7C;
        line-height: 1;
        margin-bottom: 8px;
    }

    .result-heading {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .result-sub-msg {
        font-size: 13px;
        color: #C8E5D8;
        margin-bottom: 18px;
    }

    .result-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    /* Trạng thái ẩn/hiện */
    .u-hidden {
        display: none !important;
    }
</style>

<div class="standalone-container">

    <!-- QUAY LẠI THƯ VIỆN -->
    <div class="top-return-nav">
        <a href="/Document" class="link-back-library">
            <i class="bi bi-arrow-left"></i> Trở về Thư viện mở
        </a>
    </div>

    <!-- BANNER KẾT QUẢ ĐIỂM SỐ (HIỆN LÊN ĐẦU SAU KHI NỘP BÀI) -->
    <div id="quizResultBanner" class="result-banner-box">
        <div class="result-score-num" id="finalScoreDisplay">0 / 0</div>
        <div class="result-heading font-serif-academic" id="finalResultTitle">Hoàn thành bài Quiz!</div>
        <p class="result-sub-msg">Kéo xuống dưới để xem lại chi tiết các đáp án và lời giải thích từ AI.</p>

        <div class="result-actions">
            <button type="button" class="btn-outline-neutral" onclick="location.reload()" style="background-color: rgba(255,255,255,0.15); color: #ffffff; border-color: rgba(255,255,255,0.3);">
                <i class="bi bi-arrow-counterclockwise"></i> Tạo bộ Quiz từ file khác
            </button>
            <a href="/Document" class="btn-amber-cta" style="padding: 9px 22px; font-size: 13.5px; border-radius: 100px;">
                <i class="bi bi-journals"></i> Về Thư viện
            </a>
        </div>
    </div>

    <!-- KHUNG CHÍNH CỦA TRANG -->
    <div class="academic-card">

        <!-- HEADER -->
        <div class="quiz-header">
            <span class="quiz-badge-tag">
                <i class="bi bi-magic"></i> Quick AI Quiz Generator
            </span>
            <h1 class="quiz-main-title font-serif-academic">Tạo Quiz từ tài liệu bất kỳ</h1>
            <p class="quiz-sub-desc">
                Tải lên file PDF và để AI tự động trích xuất nội dung, biên soạn bộ câu hỏi trắc nghiệm ôn tập tức thì.
            </p>
        </div>

        <!-- BƯỚC 1: MÀN HÌNH TẢI FILE & CẤU HÌNH -->
        <div id="quizSetupView">
            <form id="standaloneQuizForm" onsubmit="handleGenerateStandaloneQuiz(event)">

                <!-- Khu vực chọn file PDF -->
                <div style="margin-bottom: 20px;">
                    <label class="field-label">1. Tải lên tài liệu PDF:</label>
                    <div class="upload-dropzone" onclick="document.getElementById('pdfFileInput').click()">
                        <i class="bi bi-cloud-arrow-up dropzone-icon"></i>
                        <div class="dropzone-file-name" id="fileNameDisplay">Nhấn để chọn hoặc kéo thả file PDF vào đây</div>
                        <p class="dropzone-hint">Hỗ trợ định dạng tài liệu học tập, slide bài giảng (.pdf)</p>
                        <input type="file" id="pdfFileInput" name="file" accept=".pdf" style="display: none;" onchange="updateFileName(this)" required />
                    </div>
                </div>

                <!-- Lựa chọn số câu hỏi -->
                <div class="select-wrap">
                    <label class="field-label">2. Chọn số lượng câu hỏi:</label>
                    <select id="selectQuestionCount" class="academic-select">
                        <option value="5">5 Câu hỏi (Ôn tập nhanh)</option>
                        <option value="10" selected>10 Câu hỏi (Tiêu chuẩn)</option>
                        <option value="20">20 Câu hỏi (Chuyên sâu)</option>
                    </select>
                </div>

                <div style="text-align: center;">
                    <button type="submit" class="btn-amber-cta">
                        <i class="bi bi-cpu-fill"></i> Biên soạn bộ Quiz ngay
                    </button>
                </div>

            </form>
        </div>

        <!-- BƯỚC 2: MÀN HÌNH LOADING CHỜ AI PHÂN TÍCH -->
        <div id="quizLoadingView" class="loading-state-container u-hidden">
            <div class="academic-spinner"></div>
            <h3 class="font-serif-academic" style="color: var(--color-teal-dark); margin: 0 0 6px 0; font-size: 1.3rem;">
                AI đang đọc tài liệu và biên soạn câu hỏi...
            </h3>
            <p style="font-size: 13px; color: var(--color-text-sub); margin: 0;">
                Quá trình này mất từ 5 - 10 giây tùy thuộc vào dung lượng văn bản của tài liệu.
            </p>
        </div>

        <!-- BƯỚC 3: MÀN HÌNH LÀM BÀI TRẮC NGHIỆM -->
        <div id="quizPlayView" class="u-hidden">
            <div id="questionsListContainer"></div>

            <div id="submitBtnWrapper" style="text-align: center; margin-top: 32px; padding-top: 24px; border-top: 1.5px solid var(--color-card-border);">
                <button type="button" class="btn-teal-cta" onclick="submitStandaloneQuiz()">
                    <i class="bi bi-check2-all"></i> Nộp bài và xem điểm số
                </button>
            </div>
        </div>

    </div>

</div>

<!-- JAVASCRIPT XỬ LÝ LÀM QUIZ & HIỂN THỊ ĐÁP ÁN THÔNG MINH -->
<script>
    let standaloneQuestionsCache = [];

    function updateFileName(input) {
        if (input.files && input.files[0]) {
            document.getElementById('fileNameDisplay').innerText = "📄 Đã chọn: " + input.files[0].name;
        }
    }

    async function handleGenerateStandaloneQuiz(event) {
        event.preventDefault();
        const fileInput = document.getElementById('pdfFileInput');
        const questionCount = document.getElementById('selectQuestionCount').value;

        if (!fileInput.files || fileInput.files.length === 0) {
            alert("⚠️ Vui lòng chọn file PDF!");
            return;
        }

        const formData = new FormData();
        formData.append("file", fileInput.files[0]);
        formData.append("questionCount", questionCount);

        document.getElementById('quizSetupView').classList.add('u-hidden');
        document.getElementById('quizLoadingView').classList.remove('u-hidden');

        try {
            const response = await fetch('/api/Document/generate-standalone-quiz', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                const errText = await response.text();
                throw new Error(errText || "Không thể tạo bộ Quiz.");
            }

            standaloneQuestionsCache = await response.json();
            renderStandaloneForm(standaloneQuestionsCache);

            document.getElementById('quizLoadingView').classList.add('u-hidden');
            document.getElementById('quizPlayView').classList.remove('u-hidden');

        } catch (err) {
            alert("⚠️ Lỗi: " + err.message);
            location.reload();
        }
    }

    function renderStandaloneForm(questions) {
        const container = document.getElementById('questionsListContainer');
        let html = '';

        questions.forEach((q, index) => {
            html += `
                    <div class="question-card standalone-question-item" data-index="${index}" data-correct="${q.correctAnswer}">
                        <div class="question-title">
                            <span class="question-index-badge">Câu ${index + 1}:</span> ${escapeHtml(q.questionText)}
                        </div>
                        <div class="options-group">`;

            q.options.forEach((opt, optIdx) => {
                const optKey = String.fromCharCode(65 + optIdx);
                html += `
                        <label class="option-label">
                            <input type="radio" name="sq_${index}" value="${optKey}">
                            <span class="option-key">${optKey}.</span>
                            <span>${escapeHtml(opt)}</span>
                        </label>`;
            });

            html += `</div>
                        <div class="explanation-box" id="explain_${index}">
                            <strong>💡 Giải thích chi tiết từ AI:</strong><br/>
                            ${escapeHtml(q.explanation)}
                        </div>
                    </div>`;
        });

        container.innerHTML = html;
    }

    function submitStandaloneQuiz() {
        let correctCount = 0;
        const items = document.querySelectorAll('.standalone-question-item');

        items.forEach((item, index) => {
            const correctKey = (item.getAttribute('data-correct') || '').trim().toUpperCase();
            const selectedInput = item.querySelector(`input[name="sq_${index}"]:checked`);
            const explanationBox = document.getElementById(`explain_${index}`);

            // Mở phần giải thích từ AI
            if (explanationBox) {
                explanationBox.style.display = 'block';
            }

            const labels = item.querySelectorAll('.option-label');
            labels.forEach(lbl => {
                const input = lbl.querySelector('input');
                const val = (input.value || '').trim().toUpperCase();

                // Highlight đáp án đúng màu xanh
                if (val === correctKey) {
                    lbl.classList.add('opt-correct');
                }
                // Highlight đáp án chọn sai màu đỏ
                if (selectedInput && input === selectedInput && val !== correctKey) {
                    lbl.classList.add('opt-wrong');
                }
                // Khóa lựa chọn sau khi nộp
                input.disabled = true;
            });

            if (selectedInput && selectedInput.value.trim().toUpperCase() === correctKey) {
                correctCount++;
            }
        });

        // Ẩn nút nộp bài
        const submitWrapper = document.getElementById('submitBtnWrapper');
        if (submitWrapper) submitWrapper.classList.add('u-hidden');

        // Hiển thị Banner điểm số ở đầu trang
        const total = standaloneQuestionsCache.length;
        document.getElementById('finalScoreDisplay').innerText = `${correctCount} / ${total}`;

        let message = "Tuyệt vời! Bạn nắm rất vững nội dung tài liệu này.";
        const ratio = total > 0 ? (correctCount / total) : 0;
        if (ratio < 0.5) {
            message = "Bạn cần ôn tập kỹ hơn nội dung tài liệu nhé!";
        } else if (ratio < 0.8) {
            message = "Khá tốt! Hãy đọc lại phần giải thích các câu làm sai để củng cố thêm.";
        }
        document.getElementById('finalResultTitle').innerText = message;

        const banner = document.getElementById('quizResultBanner');
        banner.style.display = 'block';

        // Cuộn mượt lên trên để xem điểm số
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function escapeHtml(text) {
        if (!text) return '';
        return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
</script>