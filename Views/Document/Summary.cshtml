@model SmartDocumentRAG.API.Models.Document

@{
    ViewData["Title"] = "Tóm tắt tài liệu - " + Model.FileName;
}

<!-- Google Fonts: Lora (Học thuật) & Be Vietnam Pro -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* 1. RESET & BIẾN MÀU CHỦ ĐẠO */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --color-bg-main: #F4F7F4;
        --color-teal-accent: #0A7E71;
        --color-teal-dark: #14352F;
        --color-mint-light: #E7F4EE;
        --color-mint-border: #C8E5D8;
        --color-amber: #F5A623;
        --color-amber-hover: #E29413;
        --color-text-title: #142E28;
        --color-text-body: #324B45;
        --color-text-muted: #748A84;
        --color-card-border: #E1EAE5;
    }

    body {
        background-color: var(--color-bg-main);
        font-family: 'Be Vietnam Pro', -apple-system, sans-serif;
        color: var(--color-text-body);
        padding: 24px 16px 64px 16px;
        -webkit-font-smoothing: antialiased;
    }

    .font-serif-academic {
        font-family: 'Lora', Georgia, serif;
    }

    .hidden {
        display: none !important;
    }

    .summary-page-container {
        max-width: 880px;
        margin: 0 auto;
    }

    /* 2. THANH ĐIỀU HƯỚNG QUAY LẠI */
    .top-nav-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .btn-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-teal-accent);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 600;
        transition: color 0.2s ease;
    }

        .btn-back-link:hover {
            color: var(--color-teal-dark);
            text-decoration: underline;
        }

    /* 3. THẺ CHÍNH (ACADEMIC CARD) */
    .academic-card {
        background: #ffffff;
        border: 1px solid var(--color-card-border);
        border-radius: 22px;
        padding: 36px 32px;
        box-shadow: 0 8px 24px rgba(20, 53, 47, 0.05);
    }

    /* 4. HEADER TRANG TÓM TẮT */
    .summary-main-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 22px;
        margin-bottom: 28px;
        border-bottom: 1.5px solid var(--color-card-border);
    }

    .tag-ai-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: var(--color-mint-light);
        color: var(--color-teal-accent);
        border: 1px solid var(--color-mint-border);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 100px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .summary-header-title {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        line-height: 1.3;
    }

    .doc-name-subtitle {
        font-size: 14px;
        color: var(--color-text-muted);
        margin-top: 4px;
    }

        .doc-name-subtitle strong {
            color: var(--color-text-title);
        }

    .btn-library-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        color: var(--color-text-muted);
        border: 1px solid var(--color-card-border);
        border-radius: 100px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-library-pill:hover {
            background-color: var(--color-mint-light);
            color: var(--color-teal-accent);
            border-color: var(--color-mint-border);
        }

    /* 5. PHẦN 1: CẤU HÌNH KIỂU TÓM TẮT */
    .config-view-wrapper {
        text-align: center;
        padding: 24px 12px;
    }

    .config-icon-box {
        width: 72px;
        height: 72px;
        background: linear-gradient(135deg, var(--color-mint-light) 0%, #D8EDE3 100%);
        border: 2px solid var(--color-mint-border);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        font-size: 32px;
        color: var(--color-teal-accent);
        box-shadow: 0 6px 16px rgba(10, 126, 113, 0.1);
    }

    .config-title {
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        margin-bottom: 8px;
    }

    .config-desc {
        font-size: 14px;
        color: var(--color-text-muted);
        max-width: 520px;
        margin: 0 auto 28px auto;
        line-height: 1.6;
    }

    .select-style-group {
        max-width: 380px;
        margin: 0 auto 28px auto;
        text-align: left;
    }

    .select-label {
        display: block;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 8px;
        text-align: center;
    }

    .custom-select-control {
        width: 100%;
        padding: 12px 16px;
        border: 1.5px solid var(--color-card-border);
        border-radius: 12px;
        background-color: #FAFCFA;
        font-family: inherit;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--color-teal-dark);
        outline: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .custom-select-control:focus {
            border-color: var(--color-teal-accent);
            box-shadow: 0 0 0 3px rgba(10, 126, 113, 0.12);
            background-color: #ffffff;
        }

    .btn-amber-action {
        background-color: var(--color-amber);
        color: #173831;
        border: none;
        border-radius: 12px;
        padding: 13px 32px;
        font-size: 15px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(245, 166, 35, 0.28);
        transition: all 0.2s ease;
    }

        .btn-amber-action:hover {
            background-color: var(--color-amber-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(245, 166, 35, 0.38);
        }

    /* 6. PHẦN 2: MÀN HÌNH LOADING */
    .loading-view-wrapper {
        text-align: center;
        padding: 60px 16px;
    }

    .pulse-spinner {
        display: inline-block;
        width: 44px;
        height: 44px;
        border: 3.5px solid rgba(10, 126, 113, 0.2);
        border-top-color: var(--color-teal-accent);
        border-radius: 50%;
        animation: spinAnim 0.8s linear infinite;
        margin-bottom: 18px;
    }

    @@keyframes spinAnim {
        to {
            transform: rotate(360deg);
        }
    }

    /* 7. PHẦN 3: KẾT QUẢ TÓM TẮT */
    .result-view-wrapper {
        animation: fadeIn 0.35s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .result-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .result-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-teal-dark);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-copy-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        color: var(--color-teal-accent);
        border: 1.5px solid var(--color-mint-border);
        border-radius: 10px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-copy-action:hover {
            background-color: var(--color-mint-light);
            color: var(--color-teal-dark);
            border-color: var(--color-teal-accent);
        }

    .result-content-card {
        background-color: #FAFCFA;
        border: 1.5px solid var(--color-mint-border);
        border-left: 5px solid var(--color-teal-accent);
        border-radius: 14px;
        padding: 26px 28px;
        line-height: 1.75;
        font-size: 15px;
        color: var(--color-text-title);
        white-space: pre-wrap;
        word-break: break-word;
        box-shadow: 0 4px 14px rgba(20, 53, 47, 0.03);
        margin-bottom: 28px;
    }

    /* THANH HÀNH ĐỘNG DƯỚI CÙNG */
    .result-actions-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        padding-top: 20px;
        border-top: 1px solid var(--color-card-border);
    }

    .btn-secondary-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        color: var(--color-text-muted);
        border: 1.5px solid var(--color-card-border);
        border-radius: 12px;
        padding: 10px 22px;
        font-size: 13.5px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-secondary-pill:hover {
            background-color: var(--color-bg-main);
            color: var(--color-teal-dark);
            border-color: #CBD5E1;
        }

    .btn-teal-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: var(--color-teal-accent);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 10px 22px;
        font-size: 13.5px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(10, 126, 113, 0.2);
    }

        .btn-teal-action:hover {
            background-color: #08665B;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(10, 126, 113, 0.28);
        }
</style>

<div class="summary-page-container">

    <!-- THANH QUAY LẠI TRANG CHI TIẾT -->
    <div class="top-nav-bar">
        <a href="/Document/Details/@Model.Id" class="btn-back-link">
            <i class="bi bi-arrow-left"></i> Quay lại chi tiết tài liệu
        </a>
    </div>

    <!-- THẺ CHÍNH -->
    <div class="academic-card">

        <!-- HEADER -->
        <div class="summary-main-header">
            <div>
                <span class="tag-ai-badge">
                    <i class="bi bi-file-text-fill"></i> AI Summarizer Hub
                </span>
                <h1 class="summary-header-title font-serif-academic">Tóm tắt tài liệu thông minh</h1>
                <p class="doc-name-subtitle">
                    Tài liệu: <strong>@Model.FileName</strong>
                </p>
            </div>
            <div>
                <a href="/Document" class="btn-library-pill">
                    <i class="bi bi-book-half"></i> DBL Document
                </a>
            </div>
        </div>

        <!-- 1. MÀN HÌNH CẤU HÌNH BAN ĐẦU -->
        <div id="summaryConfigSection" class="config-view-wrapper">
            <div class="config-icon-box">
                <i class="bi bi-journal-text"></i>
            </div>
            <h2 class="config-title font-serif-academic">Chọn kiểu tóm tắt bạn muốn</h2>
            <p class="config-desc">
                Gemini AI sẽ trích xuất thông tin cốt lõi từ file <strong>@Model.FileName</strong> và cô đọng theo dạng thức bạn yêu cầu.
            </p>

            <div class="select-style-group">
                <label class="select-label" for="selectStyle">Định dạng kết quả:</label>
                <select id="selectStyle" class="custom-select-control">
                    <option value="bullets" selected>Gạch đầu dòng ý chính (Bullet points)</option>
                    <option value="keypoints">Ý cốt lõi & Kết luận (Key takeaways)</option>
                    <option value="paragraph">Đoạn văn xuôi mạch lạc (Paragraph style)</option>
                </select>
            </div>

            <button type="button" class="btn-amber-action" onclick="startSummarize('@Model.Id')">
                <i class="bi bi-magic"></i> Tiến hành tóm tắt ngay
            </button>
        </div>

        <!-- 2. MÀN HÌNH LOADING ĐỢI AI XỬ LÝ -->
        <div id="summaryLoadingSection" class="loading-view-wrapper hidden">
            <div class="pulse-spinner"></div>
            <h3 class="config-title font-serif-academic">AI đang đọc hiểu và tóm tắt tài liệu...</h3>
            <p style="font-size: 14px; color: var(--color-text-muted);">
                Đang cô đọng thông tin quan trọng. Quá trình này mất khoảng 5 - 10 giây!
            </p>
        </div>

        <!-- 3. MÀN HÌNH HIỂN THỊ KẾT QUẢ TÓM TẮT -->
        <div id="summaryResultSection" class="result-view-wrapper hidden">
            <div class="result-header-bar">
                <h3 class="result-title font-serif-academic">
                    <i class="bi bi-bookmark-check-fill" style="color: var(--color-teal-accent);"></i>
                    Kết quả tóm tắt
                </h3>
                <button type="button" id="btnCopyText" class="btn-copy-action" onclick="copySummaryText()">
                    <i class="bi bi-clipboard"></i>
                    <span>Sao chép kết quả</span>
                </button>
            </div>

            <!-- Khung văn bản tóm tắt -->
            <div id="summaryResultBox" class="result-content-card"></div>

            <!-- Thanh hành động sau khi tóm tắt -->
            <div class="result-actions-bar">
                <button type="button" class="btn-secondary-pill" onclick="resetConfig()">
                    <i class="bi bi-arrow-counterclockwise"></i> Chọn kiểu tóm tắt khác
                </button>
                <a href="/Document/Details/@Model.Id" class="btn-teal-action">
                    <i class="bi bi-chat-quote-fill"></i> Trở về xem tài liệu & Chat AI
                </a>
            </div>
        </div>

    </div>

</div>

<!-- JAVASCRIPT XỬ LÝ TÓM TẮT (GIỮ NGUYÊN API CONTRACT) -->
<script>
    async function startSummarize(documentId) {
        const style = document.getElementById('selectStyle').value;

        // Chuyển sang màn hình Loading
        document.getElementById('summaryConfigSection').classList.add('hidden');
        document.getElementById('summaryLoadingSection').classList.remove('hidden');

        try {
            const response = await fetch('/api/Document/summarize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ documentId: documentId, summaryStyle: style })
            });

            if (!response.ok) {
                const errDetail = await response.text();
                throw new Error(errDetail || "Không thể tạo bản tóm tắt từ tài liệu này.");
            }

            const data = await response.json();

            // Hiển thị kết quả
            document.getElementById('summaryLoadingSection').classList.add('hidden');
            const resultBox = document.getElementById('summaryResultBox');
            resultBox.innerText = data.summary;
            document.getElementById('summaryResultSection').classList.remove('hidden');

        } catch (err) {
            alert("⚠️ Lỗi: " + err.message);
            resetConfig();
        }
    }

    function copySummaryText() {
        const text = document.getElementById('summaryResultBox').innerText;
        const btn = document.getElementById('btnCopyText');

        navigator.clipboard.writeText(text).then(() => {
            // Phản hồi vi mô (Micro-interaction): Đổi nút sang trạng thái đã chép
            btn.innerHTML = `<i class="bi bi-check2"></i> <span>Đã sao chép!</span>`;
            btn.style.color = '#2E7D32';
            btn.style.borderColor = '#81C784';

            setTimeout(() => {
                btn.innerHTML = `<i class="bi bi-clipboard"></i> <span>Sao chép kết quả</span>`;
                btn.style.color = '';
                btn.style.borderColor = '';
            }, 2000);
        });
    }

    function resetConfig() {
        document.getElementById('summaryResultSection').classList.add('hidden');
        document.getElementById('summaryLoadingSection').classList.add('hidden');
        document.getElementById('summaryConfigSection').classList.remove('hidden');
    }
</script>
