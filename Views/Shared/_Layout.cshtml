@using Microsoft.AspNetCore.Http
@{
    var currentUsername = Context.Session.GetString("Username") ?? "Người dùng";
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var isCreatesActive = currentPath.Contains("standalonequiz") || currentPath.Contains("standalonesummary") || currentPath.Contains("ephemeralchat") || currentPath.Contains("/document/quiz") || currentPath.Contains("/document/summary");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DBL Document</title>

    <!-- Bootstrap Icons (Bộ icon độc lập, không dùng CSS của Bootstrap) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts: Lora (Học thuật) & Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lora:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

    <style>
            /* 1. RESET & BIẾN MÀU HỆ THỐNG */
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --color-bg-body: #FFFFFF;
                --color-sidebar-bg: #12382F;
                --color-sidebar-gradient: linear-gradient(180deg, #143E34 0%, #0E2922 100%);
                --color-teal-accent: #14734D;
                --color-teal-dark: #173831;
                --color-mint-glow: #F5B52E;
                --color-mint-light: #E8F4EB;
                --color-amber: #F5B52E;
                --color-amber-hover: #E6A51E;
                --color-text-title: #173831;
                --color-text-body: #2C523D;
                --color-text-sub: #4A6855;
                --color-border: #DCE9E0;
                --sidebar-width: 290px;
            }

            body {
                background-color: var(--color-bg-body);
                font-family: 'Be Vietnam Pro', -apple-system, sans-serif;
                color: var(--color-text-body);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                -webkit-font-smoothing: antialiased;
            }

            .font-serif-academic {
                font-family: 'Lora', Georgia, serif;
            }

            /* 2. THANH TOPBAR VỚI NÚT HAMBURGER */
            .app-topbar {
                position: sticky;
                top: 0;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                border-bottom: 1.5px solid var(--color-border);
                height: 64px;
                padding: 0 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                z-index: 900;
                box-shadow: 0 2px 12px rgba(18, 64, 53, 0.04);
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            /* NÚT HAMBURGER BAR */
            .hamburger-toggle-btn {
                background: #ffffff;
                border: 1.5px solid var(--color-border);
                border-radius: 13px;
                width: 44px;
                height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--color-teal-dark);
                font-size: 21px;
                cursor: pointer;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
            }

                .hamburger-toggle-btn:hover {
                    background-color: var(--color-teal-dark);
                    border-color: var(--color-teal-dark);
                    color: var(--color-amber);
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(10, 54, 40, 0.16);
                }

                .hamburger-toggle-btn:active {
                    transform: scale(0.95);
                }

            /* Tiêu đề Logo trên Topbar */
            .topbar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                color: var(--color-teal-dark);
            }

            .topbar-brand-icon {
                color: var(--color-teal-accent);
                font-size: 22px;
            }

            .topbar-brand-text {
                font-size: 1.15rem;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            /* Chip Người dùng trên Topbar */
            .topbar-user-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background-color: #FAFCFA;
                border: 1px solid var(--color-border);
                border-radius: 100px;
                padding: 6px 14px;
                font-size: 13px;
                font-weight: 600;
                color: var(--color-teal-dark);
            }

                .topbar-user-pill .online-dot {
                    width: 8px;
                    height: 8px;
                    background-color: #F5B52E;
                    border-radius: 50%;
                }

            /* 3. LỚP MÀN MỜ NỀN KHI MỞ MENU (BACKDROP OVERLAY) */
            .sidebar-backdrop {
                position: fixed;
                inset: 0;
                background-color: rgba(14, 41, 34, 0.5);
                backdrop-filter: blur(3px);
                z-index: 1040;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s ease;
            }

            body.menu-open .sidebar-backdrop {
                opacity: 1;
                pointer-events: auto;
            }

            /* 4. THANH MENU TRƯỢT OFF-CANVAS (SLIDE-IN SIDEBAR) */
            .app-sidebar-drawer {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: var(--sidebar-width);
                background: var(--color-sidebar-gradient);
                color: #ffffff;
                z-index: 1050;
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 24px 20px;
                box-shadow: 8px 0 32px rgba(10, 38, 31, 0.25);
                overflow-y: auto;
            }

            body.menu-open .app-sidebar-drawer {
                transform: translateX(0);
            }

            /* Header trong Sidebar: Logo + Nút Đóng (X) */
            .drawer-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 28px;
                padding-bottom: 16px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .drawer-brand-box {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                color: #ffffff;
            }

            .drawer-brand-icon {
                width: 38px;
                height: 38px;
                background: rgba(156, 231, 213, 0.15);
                border: 1.5px solid rgba(156, 231, 213, 0.3);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--color-mint-glow);
                font-size: 18px;
            }

            .drawer-brand-text {
                font-size: 1.1rem;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            /* Nút đóng menu (X) */
            .btn-close-drawer {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: rgba(255, 255, 255, 0.8);
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                cursor: pointer;
                transition: all 0.2s ease;
            }

                .btn-close-drawer:hover {
                    background-color: var(--color-amber);
                    color: var(--color-teal-dark);
                    border-color: var(--color-amber);
                    transform: rotate(90deg) scale(1.03);
                }

            /* --- DANH SÁCH MENU --- */
            .drawer-nav-menu {
                flex-grow: 1;
            }

            .nav-group-title {
                font-size: 11px;
                font-weight: 700;
                color: rgba(156, 231, 213, 0.6);
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 0 10px;
                margin-bottom: 12px;
            }

            .drawer-menu-list {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .drawer-nav-item {
                position: relative;
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 12px 16px;
                border-radius: 14px;
                color: rgba(255, 255, 255, 0.82);
                font-size: 14.5px;
                font-weight: 500;
                text-decoration: none;
                transition: all 0.22s ease;
                overflow: hidden;
            }

                .drawer-nav-item i {
                    font-size: 18px;
                    color: rgba(255, 255, 255, 0.6);
                    width: 20px;
                    text-align: center;
                    transition: transform 0.2s ease, color 0.2s ease;
                }

                .drawer-nav-item::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 25%;
                    height: 50%;
                    width: 4px;
                    border-radius: 0 4px 4px 0;
                    background-color: var(--color-mint-glow);
                    transform: scaleY(0);
                    transition: transform 0.2s ease;
                }

                .drawer-nav-item:hover {
                    background-color: rgba(255, 255, 255, 0.08);
                    color: #ffffff;
                    transform: translateX(6px);
                }

                    .drawer-nav-item:hover i {
                        color: var(--color-mint-glow);
                        transform: scale(1.15);
                    }

                    .drawer-nav-item:hover::before {
                        transform: scaleY(1);
                    }

                .drawer-nav-item.active {
                    background: linear-gradient(90deg, rgba(10, 126, 113, 0.45) 0%, rgba(10, 126, 113, 0.15) 100%);
                    color: #ffffff;
                    font-weight: 700;
                    border: 1px solid rgba(156, 231, 213, 0.25);
                }

                    .drawer-nav-item.active i {
                        color: var(--color-mint-glow);
                    }

                    .drawer-nav-item.active::before {
                        transform: scaleY(1);
                        background-color: var(--color-amber);
                    }

                .drawer-nav-item.item-upload:hover i,
                .drawer-nav-item.item-creates:hover i {
                    color: var(--color-amber);
                }

            .drawer-menu-group {
                border-radius: 14px;
            }

            .drawer-menu-summary {
                list-style: none;
                cursor: pointer;
                justify-content: flex-start;
            }

            .drawer-menu-summary::-webkit-details-marker {
                display: none;
            }

            .drawer-menu-summary .menu-chevron {
                width: auto;
                margin-left: auto;
                font-size: 13px;
                transition: transform 0.2s ease;
            }

            .drawer-menu-group[open] .menu-chevron {
                transform: rotate(180deg);
                color: var(--color-amber);
            }

            .drawer-menu-group[open] > .drawer-menu-summary {
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
            }

            .drawer-submenu {
                list-style: none;
                margin: 2px 0 8px 24px;
                padding: 4px 0 4px 14px;
                border-left: 1px solid rgba(245, 166, 35, 0.45);
                display: flex;
                flex-direction: column;
                gap: 3px;
            }

            .drawer-submenu a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 11px;
                border-radius: 9px;
                color: rgba(255, 255, 255, 0.76);
                font-size: 13px;
                text-decoration: none;
                transition: color 0.18s ease, background 0.18s ease;
            }

            .drawer-submenu a i {
                color: rgba(245, 166, 35, 0.85);
                font-size: 14px;
            }

            .drawer-submenu a:hover,
            .drawer-submenu a.active {
                background: rgba(255, 255, 255, 0.1);
                color: #ffffff;
            }

            .drawer-submenu a.active {
                box-shadow: inset 2px 0 0 var(--color-amber);
            }

            /* --- PHẦN CUỐI MENU: USER & ĐĂNG XUẤT --- */
            .drawer-footer {
                padding-top: 18px;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .user-card-badge {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                background-color: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 14px;
                cursor: default;
                transition: all 0.2s ease;
            }

                .user-card-badge:hover {
                    background-color: rgba(255, 255, 255, 0.09);
                    border-color: rgba(156, 231, 213, 0.25);
                    transform: translateY(-1px);
                }

            .user-avatar-circle {
                position: relative;
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--color-teal-accent) 0%, var(--color-amber) 100%);
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                flex-shrink: 0;
            }

                .user-avatar-circle .status-dot {
                    position: absolute;
                    bottom: 0;
                    right: 0;
                    width: 9px;
                    height: 9px;
                    background-color: #F5B52E;
                    border: 2px solid #12382F;
                    border-radius: 50%;
                }

            .user-info-text {
                overflow: hidden;
            }

            .user-name-title {
                font-size: 13.5px;
                font-weight: 700;
                color: #ffffff;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .user-role-sub {
                font-size: 11px;
                color: rgba(255, 255, 255, 0.6);
            }

            .btn-drawer-logout {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 16px;
                border-radius: 12px;
                color: rgba(255, 255, 255, 0.76);
                font-size: 13.5px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.22s ease;
            }

                .btn-drawer-logout i {
                    font-size: 18px;
                    transition: transform 0.2s ease;
                }

                .btn-drawer-logout:hover {
                    background-color: rgba(245, 166, 35, 0.14);
                    color: var(--color-amber);
                    transform: translateX(4px);
                }

                    .btn-drawer-logout:hover i {
                        transform: translateX(4px);
                    }

            /* 5. NỘI DUNG CHÍNH (MAIN) & FOOTER PHONG CÁCH HỌC THUẬT */
            .app-body-container {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
            }

            .page-content-area {
                flex-grow: 1;
            }

            .app-footer {
                margin-top: auto;
                padding: 38px max(30px, calc((100% - 1380px) / 2)) 18px;
                color: #ffffff;
                background: linear-gradient(115deg, #12382F, #0E4A38 65%, #12614A);
                border-top: 3px solid var(--color-amber);
            }

            .footer-inner {
                display: grid;
                grid-template-columns: 1.5fr .8fr .9fr 1.2fr;
                gap: 36px;
                max-width: 1380px;
                margin: 0 auto;
                padding-bottom: 28px;
            }

            .footer-brand {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                color: #ffffff;
                font-family: 'Lora', Georgia, serif;
                font-size: 20px;
                font-weight: 500;
                text-decoration: none;
            }

            .footer-brand strong { color: var(--color-amber); }
            .footer-brand-icon { color: var(--color-amber); font-size: 24px; }
            .footer-brand-column p { max-width: 320px; margin: 14px 0; color: rgba(255,255,255,.78); line-height: 1.7; font-size: 13px; }
            .footer-product-label { display: inline-flex; align-items: center; gap: 7px; color: var(--color-amber); font-size: 11px; font-weight: 700; letter-spacing: .5px; }
            .footer-column, .footer-team-column { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; }
            .footer-column h2, .footer-team-column h2 { margin: 3px 0 5px; color: var(--color-amber); font-size: 12px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; }
            .footer-column a { color: rgba(255,255,255,.82); font-size: 13px; text-decoration: none; transition: color .18s ease, transform .18s ease; }
            .footer-column a:hover { color: var(--color-amber); transform: translateX(3px); }
            .footer-team-member { display: flex; align-items: center; gap: 9px; color: rgba(255,255,255,.88); font-size: 12px; }
            .footer-team-avatar { width: 27px; height: 27px; display: grid; place-items: center; border: 1px solid rgba(245,181,46,.6); border-radius: 50%; color: var(--color-amber); font-size: 9px; font-weight: 700; }
            .footer-team-member a { margin-left: auto; color: #ffffff; font-size: 14px; }
            .footer-team-member a:hover { color: var(--color-amber); }
            .footer-bottom { max-width: 1380px; margin: 0 auto; padding-top: 15px; border-top: 1px solid rgba(255,255,255,.2); display: flex; justify-content: space-between; gap: 12px; color: rgba(255,255,255,.68); font-size: 11px; }

            @@media (max-width: 900px) {
                .footer-inner { grid-template-columns: 1.2fr 1fr; gap: 28px; }
            }

            @@media (max-width: 560px) {
                .app-footer { padding: 30px 20px 16px; }
                .footer-inner { grid-template-columns: 1fr 1fr; gap: 26px 18px; }
                .footer-brand-column { grid-column: 1 / -1; }
                .footer-bottom { flex-direction: column; }
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- 1. TOPBAR CỐ ĐỊNH CHỨA NÚT HAMBURGER BAR -->
    <header class="app-topbar">
        <div class="topbar-left">
            <!-- NÚT HAMBURGER BẤM MỞ MENU -->
            <button class="hamburger-toggle-btn" id="btnOpenMenu" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>

            <!-- LOGO TIÊU ĐỀ TRÊN TOPBAR -->
            <a href="/Document" class="topbar-brand">
                <i class="bi bi-journals topbar-brand-icon"></i>
                <span class="topbar-brand-text font-serif-academic">DBL Document</span>
            </a>
        </div>

        <div class="topbar-right">
            <!-- CHIP TÀI KHOẢN GÓC PHẢI -->
            <div class="topbar-user-pill">
                <span class="online-dot"></span>
                <i class="bi bi-person-fill"></i>
                <span>@currentUsername</span>
            </div>
        </div>
    </header>

    <!-- 2. LỚP MÀN MỜ NỀN KHI MỞ MENU TRƯỢT -->
    <div class="sidebar-backdrop" id="menuBackdrop"></div>

    <!-- 3. THANH MENU TRƯỢT OFF-CANVAS BÊN TRÁI (HAMBURGER DRAWER) -->
    <aside class="app-sidebar-drawer" id="sidebarDrawer">

        <!-- Header Drawer: Logo & Nút Đóng (X) -->
        <div class="drawer-header">
            <a href="/Document" class="drawer-brand-box">
                <div class="drawer-brand-icon">
                    <i class="bi bi-journals"></i>
                </div>
                <div class="drawer-brand-text font-serif-academic">DBL Document</div>
            </a>
            <button class="btn-close-drawer" id="btnCloseMenu" aria-label="Đóng menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Danh sách mục điều hướng -->
        <nav class="drawer-nav-menu">
            <div class="nav-group-title">Điều hướng</div>
            <ul class="drawer-menu-list">

                <!-- MỤC 1: TRANG CHỦ -->
                <li>
                    <a href="/Document" class="drawer-nav-item @(currentPath == "/document" || currentPath == "/" || currentPath.EndsWith("/index") ? "active" : "")">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>

                <!-- MỤC 2: TẢI LÊN -->
                <li>
                    <a href="/Document/UploadPage" class="drawer-nav-item item-upload @(currentPath.Contains("/uploadpage") ? "active" : "")">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>Tải lên</span>
                    </a>
                </li>

                <!-- Nhóm công cụ Creates -->
                <li>
                    <details class="drawer-menu-group item-creates" open="@(isCreatesActive ? "open" : null)">
                        <summary class="drawer-nav-item drawer-menu-summary @(isCreatesActive ? "active" : "")">
                            <i class="bi bi-stars"></i>
                            <span>Creates</span>
                            <i class="bi bi-chevron-down menu-chevron"></i>
                        </summary>
                        <ul class="drawer-submenu">
                            <li><a href="/Document/StandaloneQuiz" class="@(currentPath.Contains("standalonequiz") || currentPath.Contains("/document/quiz") ? "active" : "")"><i class="bi bi-patch-question-fill"></i><span>Tạo Quiz</span></a></li>
                            <li><a href="/Document/StandaloneSummary" class="@(currentPath.Contains("standalonesummary") || currentPath.Contains("/document/summary") ? "active" : "")"><i class="bi bi-file-text-fill"></i><span>Tóm tắt tài liệu</span></a></li>
                            <li><a href="/Document/EphemeralChat" class="@(currentPath.Contains("ephemeralchat") ? "active" : "")"><i class="bi bi-chat-left-text-fill"></i><span>Hỏi đáp</span></a></li>
                        </ul>
                    </details>
                </li>

                <!-- MỤC 3: TÀI LIỆU CỦA TÔI -->
                <li>
                    <a href="/Document/List" class="drawer-nav-item @(currentPath.Contains("/document/list") ? "active" : "")">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Tài liệu của tôi</span>
                    </a>
                </li>

            </ul>
        </nav>

        <!-- Phần dưới cùng: Người dùng & Đăng xuất -->
        <div class="drawer-footer">

            <!-- MỤC 4: NGƯỜI DÙNG -->
            <div class="user-card-badge" title="Tài khoản hiện tại">
                <div class="user-avatar-circle">
                    <i class="bi bi-person-fill"></i>
                    <span class="status-dot"></span>
                </div>
                <div class="user-info-text">
                    <div class="user-name-title">@currentUsername</div>
                    <div class="user-role-sub">Thành viên thư viện</div>
                </div>
            </div>

            <!-- MỤC 5: ĐĂNG XUẤT Ở DƯỚI CÙNG -->
            <a href="/Account/Logout" class="btn-drawer-logout" title="Đăng xuất khỏi hệ thống">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất</span>
            </a>

        </div>

    </aside>

    <!-- 4. KHUNG NỘI DUNG CHÍNH (RENDER BODY) -->
    <div class="app-body-container">
        <main class="page-content-area">
            @RenderBody()
        </main>

        <!-- FOOTER THÔNG TIN NHÀ PHÁT TRIỂN -->
        <footer class="app-footer">
            <div class="footer-inner">
